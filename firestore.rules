rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn()
        && data.userIds is list
        && request.auth.uid in data.userIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && isParticipant(resource.data);

      allow create: if signedIn()
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if signedIn() && isParticipant(resource.data);
    }
  }
}